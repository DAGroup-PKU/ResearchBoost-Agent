{
  "task": "SGF framewise training",
  "world_size": 4,
  "python": "/usr/bin/python3",
  "candidate_python": "/opt/candidate-env/bin/python",
  "reference_python": "/opt/reference-env/bin/python",
  "assets": "/opt/researchboost/assets",
  "run_timeout_sec": 1200,
  "reference": "targets/reference",
  "reference_commit": "79be9acbd874c9be050944a6b1de6693e988a171",
  "reference_baseline": {
    "base_config": "configs/self_gradient_forcing_framewise.yaml",
    "config": {
      "mixed_precision": true,
      "gradient_checkpointing": true
    },
    "trainer_tf32": {
      "torch.backends.cuda.matmul.allow_tf32": true,
      "torch.backends.cudnn.allow_tf32": true
    },
    "flash_attention": {
      "dispatch": "pinned upstream dispatch at its existing call sites",
      "reference_package": "flash_attn",
      "reference_backend": "FlashAttention-2",
      "require_active": true,
      "allow_reference_fallback": false,
      "rewrite_other_upstream_attention_paths": false
    }
  },
  "gate0": {
    "exact_items": {
      "config": {
        "batch_size": 1,
        "total_batch_size": 4,
        "sharding_strategy": "hybrid_full",
        "num_frame_per_block": 1,
        "image_or_video_shape": [
          1,
          21,
          16,
          60,
          104
        ],
        "denoising_step_list": [
          1000,
          750,
          500,
          250
        ],
        "model_kwargs": {
          "model_name": "Wan2.1-T2V-1.3B",
          "timestep_shift": 5.0,
          "local_attn_size": 6,
          "sink_size": 3
        },
        "grad_mode": "self_gradient_forcing",
        "self_gradient_forcing_cache_mode": "exit",
        "per_rank_exit_step": true,
        "self_gradient_forcing_match_context": true,
        "dfake_gen_update_ratio": 5,
        "distribution_loss": "dmd",
        "trainer": "score_distillation"
      },
      "runtime": {
        "world_size": 4,
        "nnodes": 1,
        "gradient_accumulation_steps": 1,
        "pass1_blocks_per_rollout": 21,
        "pass1_denoising_stages_per_block": 4,
        "pass1_context_updates_per_block": 1,
        "fsdp_forward_parameter_dtype": "bfloat16",
        "fsdp_reduce_dtype": "float32",
        "fsdp_buffer_dtype": "float32"
      },
      "reference_matched": {
        "training_config": "resolved training config and optimizer/EMA hyperparameters",
        "input_fingerprints": "frozen assets, starting weights and starting state",
        "sample_ids": "per-rank ordered sample IDs for each optimizer update",
        "sampling_fingerprints": "per-rank noise, RNG and sampled exits",
        "rollout_trace": "per-rank ordered blocks, denoising stages and context updates",
        "context_trace": "cache state selection and Pass 2 context and gradient boundaries",
        "tensor_metadata": "shapes and dtypes, including parameters, reductions and optimizer state",
        "update_trace": "completed trainer step IDs and ordered optimizer calls"
      }
    },
    "exact_mismatch_status": "INCORRECT",
    "update_boundary": {
      "trainer": "trainer.distillation.Trainer.train",
      "counter": "self.step",
      "event": "after critic_optimizer.step(), at self.step += 1",
      "schedule": {
        "critic_only": [
          "critic"
        ],
        "generator_dmd_and_critic": [
          "generator",
          "critic"
        ],
        "generator_starts_after_step_zero": true,
        "generator_step_modulo": 0,
        "generator_period_config_key": "dfake_gen_update_ratio"
      }
    }
  },
  "switches": {
    "allowed_candidate_environment": [],
    "reference_defaults_eligible_for_ladder": false,
    "implementation_change_required": true
  },
  "run_validity": {
    "require_all_ranks_and_updates_complete": true,
    "require_input_and_source_fingerprints_unchanged": true,
    "check_log_signatures_even_on_zero_exit": true,
    "invalid_run_status": "INVALID"
  },
  "gpu_lock": "/tmp/sgf_framewise_gpu.lock",
  "record": {
    "reference": "bench/records/ref.json"
  },
  "timing": {
    "windows": [
      [
        1,
        6
      ],
      [
        6,
        11
      ],
      [
        11,
        16
      ]
    ],
    "heldout_window_offsets": [
      1,
      2
    ],
    "field": "s_per_update",
    "spread_band": 0.05,
    "spread_band_status": "provisional_machine_check_band",
    "final_order": [
      "reference_a",
      "candidate",
      "reference_b"
    ],
    "speedup_statistic": "mean of per-window min(reference_a, reference_b) / candidate",
    "reference_spread_statistic": "max of per-window abs(reference_a - reference_b) / min(reference_a, reference_b)",
    "over_band_status": "INVALID",
    "use_heldout_windows_in_final": true
  },
  "benefit": {
    "min_speedup": 1.02,
    "reference_spread_multiplier": 2,
    "threshold": "max(min_speedup, 1 + reference_spread_multiplier * reference_spread)",
    "require_strictly_above_threshold": true,
    "below_threshold_status": "UNAVAILABLE"
  },
  "correctness": {
    "accepted_tiers": [
      "N1"
    ],
    "bitwise_match_waives_trajectory": false,
    "final_required_gates": [
      0,
      1,
      3
    ],
    "trajectory": {
      "production_config": true,
      "reference_seed_count": 3,
      "reference_seeds": [
        42,
        117,
        231
      ],
      "completed_steps": 6,
      "heldout_seed_count": 1,
      "sigma_multiplier": 3,
      "pair_by_seed_and_completed_step": true,
      "use_heldout_seeds_in_final": true,
      "require_all_endpoint_groups": true,
      "endpoints_by_step_type": {
        "critic_only": [
          "critic_loss",
          "critic_gradient_norm",
          "critic_parameter_delta"
        ],
        "generator_dmd_and_critic": [
          "generator_dmd_loss",
          "generator_gradient_norm",
          "generator_parameter_delta",
          "critic_loss",
          "critic_gradient_norm",
          "critic_parameter_delta"
        ]
      }
    }
  },
  "reserved_env": [
    "PATH",
    "PYTHONPATH",
    "PYTHONHOME",
    "LD_PRELOAD",
    "LD_LIBRARY_PATH",
    "CUDA_VISIBLE_DEVICES",
    "CUDA_DEVICE_ORDER",
    "MASTER_ADDR",
    "MASTER_PORT",
    "RANK",
    "LOCAL_RANK",
    "WORLD_SIZE",
    "LOCAL_WORLD_SIZE",
    "NNODES",
    "NODE_RANK",
    "NUM_GPUS",
    "TORCHRUN",
    "PROJECT_ROOT",
    "CONFIG",
    "LOGDIR",
    "ENABLE_WANDB",
    "TMPDIR",
    "HF_HOME",
    "HF_HUB_OFFLINE",
    "WANDB_MODE",
    "CUBLAS_WORKSPACE_CONFIG",
    "NVIDIA_TF32_OVERRIDE",
    "PYTORCH_CUDA_ALLOC_CONF"
  ],
  "invalid_run_signatures": [
    {
      "regex": "(?i)out of (?:GPU )?memory|(?:torch(?:\\.cuda)?\\.)?OutOfMemoryError|CUDA_ERROR_OUT_OF_MEMORY|CUBLAS_STATUS_ALLOC_FAILED|oom[-_ ]kill",
      "reason": "incomplete GPU workload"
    },
    {
      "regex": "(?i)NCCL[^\\n]*(?:watchdog|timed?[- ]?out|timeout)|watchdog caught collective operation timeout|collective[^\\n]*timed out",
      "reason": "incomplete collective"
    },
    {
      "regex": "(?i)hit config\\.(?:accumulated_)?(?:recompile_limit|cache_size_limit)|(?:recompile|compilation) limit (?:exceeded|reached)|WON'T CONVERT|(?:compile|dynamo|inductor)[^\\n]*(?:fall(?:ing)? back|fallback)|BackendCompilerFailed",
      "reason": "requested compiled path failed or fell back"
    },
    {
      "regex": "(?i)(?:skipp(?:ing|ed)[^\\n]*cuda[-_ ]?graphs?|cuda[-_ ]?graphs?[^\\n]*skipp(?:ing|ed))",
      "reason": "requested CUDA graph path was skipped"
    }
  ]
}
