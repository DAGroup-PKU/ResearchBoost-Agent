{
 "task": "State transition model (Arc Institute, arcinstitute/state @ 9bbfe78) on a slice of Tahoe-100M: one step of perturbation-response training on one A800",
 "world_size": 1,
 "per_rank_batch": 8,
 "agent_max_tier": "N2",
 "math_mode": "default",
 "python": "${ASSETS}/env/bin/python",
 "reference": "targets/reference",
 "reference_commit": "9bbfe78a434a55205e4de834e1ea99f85f7a3add",
 "gpu_lock": "/tmp/state_gpu.lock",
 "scratch": "/tmp",
 "hf_home": "${ASSETS}/hf",
 "fixture": {
  "toml": "bench/dataset.toml",
  "dataset_dir": "${ASSETS}/data/dataset",
  "gene_metadata": "${ASSETS}/data/gene_metadata.parquet",
  "hvg": 2000
 },
 "numerics": {
  "adapter": "bench.state_adapter:StateAdapter",
  "cases": "bench/cases.json",
  "sketch_dim": 4096,
  "ref": "bench/records/ref",
  "thresholds": "bench/thresholds.json",
  "keep_records": false,
  "exclude": []
 },
 "timing": {
  "warmup": 30,
  "window": 40,
  "repeats": 3,
  "frozen_band": 0.3,
  "pair_band": 0.25,
  "window_band": 0.3,
  "window_band_candidate": 0.35
 },
 "benefit": {
  "min_speedup": 1.02
 },
 "trajectory": {
  "spec": "bench/traj/spec.json",
  "frozen": "bench/traj/frozen.json",
  "ref": "bench/traj/ref",
  "seed_schedule": [
   1,
   3
  ]
 },
 "timeouts_s": {
  "timing": 3600,
  "profile": 3600,
  "numerics": 3600,
  "trajectory": 7200
 },
 "min_scratch_free_gib": 20,
 "reserved_env": [
  "TMPDIR",
  "TMP",
  "TEMP",
  "TORCHINDUCTOR_CACHE_DIR",
  "TRITON_CACHE_DIR",
  "CUDA_CACHE_PATH",
  "XDG_CACHE_HOME",
  "MPLCONFIGDIR",
  "HF_HOME",
  "HF_HUB_OFFLINE",
  "TRANSFORMERS_OFFLINE",
  "HF_DATASETS_OFFLINE",
  "WANDB_MODE",
  "WANDB_DIR",
  "PYTHONNOUSERSITE",
  "PYTHONPATH",
  "PATH",
  "CUDA_VISIBLE_DEVICES",
  "NCCL_DEBUG",
  "OMP_NUM_THREADS",
  "MASTER_ADDR",
  "MASTER_PORT",
  "WORLD_SIZE",
  "RANK",
  "LOCAL_RANK",
  "PL_TRAINER_DEVICES",
  "LOCAL_WORLD_SIZE",
  "GROUP_RANK",
  "NODE_RANK"
 ],
 "invalid_run_signatures": [
  {
   "regex": "out of memory|CUDA out of memory",
   "reason": "the run ran out of GPU memory"
  },
  {
   "regex": "loss: nan|loss=nan|Loss.*inf",
   "reason": "the run diverged (nan or inf loss)"
  },
  {
   "regex": "RuntimeError: DataLoader worker \\(pid \\d+\\) is killed",
   "reason": "a data-loader worker died"
  },
  {
   "regex": "NCCL error|Watchdog caught collective operation timeout",
   "reason": "a collective failed or timed out"
  }
 ]
}