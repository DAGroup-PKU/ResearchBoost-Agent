# Copy to researchboost.env, set the two roots, and pass it to every run:
#   harbor run -p tasks -i llava --env-file researchboost.env -a <agent> -m <model> -n 1
# Use absolute paths on the Docker host.

# Data and weights. Task <task> uses <assets root>/<task>, read-only inside the trial. llava, yoco and bagel_sft
# download what is missing at the start of a trial; the other tasks are provisioned beforehand (see README.md, Assets).
RESEARCHBOOST_ASSETS_ROOT=/data/researchboost/assets

# Scratch space. <scratch root>/<task> becomes the trial's /tmp, where the judge needs 200 GiB free. It is emptied
# when a trial starts: run one trial per host at a time. It must be a local filesystem that supports Unix sockets
# (DataLoader workers create theirs under /tmp); some network and FUSE filesystems do not, and startup stops then.
RESEARCHBOOST_SCRATCH_ROOT=/data/researchboost/scratch

# Optional: a Hugging Face mirror for the asset downloads.
# HF_ENDPOINT=https://huggingface.co
# Optional (integration testing only): prepare and grade the quick check only; no score.
# RESEARCHBOOST_SMOKE=1
